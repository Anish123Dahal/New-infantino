// This is your Prisma schema file.
// Production uses PostgreSQL.
// Set DATABASE_URL (pooled) and DIRECT_URL (direct connection) in your .env file.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Campaign {
  id            String       @id @default(uuid())
  slug          String       @unique
  title         String
  headline      String?
  description   String?
  goal          Decimal?
  votingEnabled Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  voteOptions        VoteOption[]
  votes              Vote[]
  signatures         Signature[]
  dailyCampaignStats DailyCampaignStat[]
}

model VoteOption {
  id          String   @id @default(uuid())
  campaignId  String
  label       String
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id])
  votes    Vote[]

  @@index([campaignId])
}

model Vote {
  id         String   @id @default(uuid())
  campaignId String
  optionId   String
  voterHash  String
  ipHash     String
  deviceHash String
  status     String   @default("ACCEPTED")
  createdAt  DateTime @default(now())

  campaign Campaign   @relation(fields: [campaignId], references: [id])
  option   VoteOption @relation(fields: [optionId], references: [id])

  @@unique([campaignId, voterHash])
  @@index([campaignId, optionId])
}

model Signature {
  id          String    @id @default(uuid())
  publicId    String    @unique @default(uuid())
  campaignId  String
  displayName String
  countryCode String
  emailHash   String?
  ipHash      String?
  deviceHash  String?
  status      String    @default("PENDING")
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())

  campaign           Campaign            @relation(fields: [campaignId], references: [id])
  emailVerifications EmailVerification[]
  fraudEvents        FraudEvent[]

  @@index([campaignId, status])
  @@index([campaignId, countryCode])
}

model EmailVerification {
  id          String    @id @default(uuid())
  signatureId String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  signature Signature @relation(fields: [signatureId], references: [id])
}

model FraudEvent {
  id          String    @id @default(uuid())
  signatureId String
  type        String
  detail      String?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())

  signature Signature @relation(fields: [signatureId], references: [id])

  @@index([resolvedAt])
}

model Admin {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  role         String    @default("ADMIN")
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
}

model DailyCampaignStat {
  id                 String   @id @default(uuid())
  campaignId         String
  date               DateTime
  verifiedSignatures Int      @default(0)
  createdAt          DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id])

  @@unique([campaignId, date])
  @@index([campaignId, date])
}
